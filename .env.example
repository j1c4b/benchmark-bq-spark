# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=benchmark-bq-spark
GOOGLE_CLOUD_REGION=us-east1
GCS_BUCKET_NAME=hospital-cost-source-data

# BigQuery Configuration
BIGQUERY_DATASET=healthcare_benchmark
BIGQUERY_TABLE=hosp_cost_report

# Service Account (optional if using default credentials)
GOOGLE_APPLICATION_CREDENTIALS=credentials/benchmark-service-account-key.json

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_EXECUTOR_MEMORY=4g
SPARK_DRIVER_MEMORY=2g

# Data URLs (CMS HCRIS)
HCRIS_DATA_URL=https://www.cms.gov/data-research/files-for-order/costdatafiles
DATA_DOWNLOAD_PATH=data/raw